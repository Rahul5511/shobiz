{
  "source": "Portal Access, Roles and Permissions v1.0 ? Starting roles for Shobiz",
  "features": [
    {
      "id": "clients",
      "name": "Clients",
      "module": "Clients",
      "description": "See clients, their contacts and their team."
    },
    {
      "id": "event-details",
      "name": "Event details",
      "module": "Events",
      "description": "See all details of events in scope, including key client contacts."
    },
    {
      "id": "client-requirements-log",
      "name": "Client requirements log",
      "module": "Events",
      "description": "Read the log. Not available to Client roles."
    },
    {
      "id": "drf-and-wishlist",
      "name": "DRF and wishlist",
      "module": "Database",
      "description": "See the DRF, requirement tracker and wishlist matches."
    },
    {
      "id": "extraction-and-verification",
      "name": "Extraction and verification",
      "module": "Database",
      "description": "See extracted datasets, snapshots and shortfall flags."
    },
    {
      "id": "samples",
      "name": "Samples",
      "module": "Database",
      "description": "See samples and their status. Client roles can also approve, reject or request changes."
    },
    {
      "id": "sample-feedback",
      "name": "Sample feedback",
      "module": "Database",
      "description": "See recorded client feedback."
    },
    {
      "id": "lots-and-handover",
      "name": "Lots and handover",
      "module": "Database",
      "description": "See lot summaries and handover status."
    },
    {
      "id": "master-database",
      "name": "Master Database",
      "module": "Database",
      "description": "Search and view the Master Database."
    },
    {
      "id": "suppression-and-flag-overrides",
      "name": "Suppression and flag overrides",
      "module": "Database",
      "description": "See suppressions and competitor and partner flags."
    },
    {
      "id": "campaigns-and-handover",
      "name": "Campaigns and handover",
      "module": "Response",
      "description": "See the Response workspace, handover readiness, campaigns and progress."
    },
    {
      "id": "records-and-lots",
      "name": "Records and lots",
      "module": "Response",
      "description": "See received lots and records."
    },
    {
      "id": "broadcasts",
      "name": "Broadcasts",
      "module": "Response",
      "description": "See broadcast lists and progress."
    },
    {
      "id": "test-broadcasts",
      "name": "Test broadcasts",
      "module": "Response",
      "description": "See test results."
    },
    {
      "id": "sender-settings-and-connections",
      "name": "Sender settings and connections",
      "module": "Response",
      "description": "See sender lists."
    },
    {
      "id": "response-handover",
      "name": "Response handover",
      "module": "AG",
      "description": "See the response handover and its status."
    },
    {
      "id": "campaign-assets",
      "name": "Campaign assets",
      "module": "AG",
      "description": "See assets and their versions."
    },
    {
      "id": "registration-data",
      "name": "Registration data",
      "module": "Registrations",
      "description": "See registration summaries, analytics, approval status and registration rows."
    },
    {
      "id": "approvals-and-messages",
      "name": "Approvals and messages",
      "module": "Registrations",
      "description": "See recommendations, decisions and waiting times."
    },
    {
      "id": "calling-management",
      "name": "Calling management",
      "module": "Telecalling",
      "description": "See team calling progress, status summaries, Telecaller performance and calling-number performance. Can also listen to call recordings, where the telephony solution provides them, if the role has With PII on Response."
    },
    {
      "id": "calling-work-own-records",
      "name": "Calling work (own records)",
      "module": "Telecalling",
      "description": "See the user's own call queue and history."
    },
    {
      "id": "reports-and-downloads",
      "name": "Reports and downloads",
      "module": "Reports",
      "description": "Open the dashboard and the reports that the user's access allows. Always on."
    }
  ],
